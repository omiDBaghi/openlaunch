# Copy to .env.local for local dev. Never commit real values.

# Public site URL (used in metadata, image URLs, share cards)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Browser RPCs (the site proxies mainnet reads through /api/rpc; these are for local anvil forks)
NEXT_PUBLIC_RPC_URL_BASE=https://mainnet.base.org
NEXT_PUBLIC_RPC_URL_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com
# NEXT_PUBLIC_RPC_URL_ARC=http://127.0.0.1:8547   # only with a third anvil fork of Arc; unset, Arc reads go through /api/rpc

# Server RPCs (indexer + read proxy). Alchemy works for all three chains, but cannot execute Base's B20
# stock tokens — BASE_B20_RPC_URL is the fallback node for those (default: base-rpc.publicnode.com).
# Arc without a key: https://rpc.mainnet.arc.io (the chain default when ARC_RPC_URL is unset).
BASE_RPC_URL=https://mainnet.base.org
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Arc: the official public node rate-limits bursts; use a keyed provider in production
# (Alchemy arc-mainnet, dRPC rpc.drpc.mainnet.arc.io, Blockdaemon rpc.blockdaemon.mainnet.arc.io, QuickNode).
ARC_RPC_URL=https://rpc.mainnet.arc.io
# BASE_B20_RPC_URL=https://base-rpc.publicnode.com

# Postgres (schema in db/schema.sql; `npm run migrate` applies it idempotently)
DATABASE_URL=postgres://localhost/openlaunch_dev

# Launchpad contracts per chain (same addresses on both chains for the live deployment)
NEXT_PUBLIC_LAUNCH_FACTORY=0x3b307bC24Ca121F841BFf2d118FD69F61E149307
NEXT_PUBLIC_LAUNCH_LOCKER=0x8357E773f5a251173f1AB412Dae6A986883cF8c7
LAUNCH_DEPLOY_BLOCK=51595449
NEXT_PUBLIC_LAUNCH_FACTORY_ROBINHOOD=0x4Ab253311e28511a48b2525b623Ef4813abEC27E
NEXT_PUBLIC_LAUNCH_LOCKER_ROBINHOOD=0x95bb2a42d3B685754548ffC8BC547E0fb2113252
LAUNCH_DEPLOY_BLOCK_ROBINHOOD=68664471
# Arc (5042): set once the factory is deployed there; unset = the site shows Arc as "Coming soon"
NEXT_PUBLIC_LAUNCH_FACTORY_ARC=0x4Ab253311e28511a48b2525b623Ef4813abEC27E
NEXT_PUBLIC_LAUNCH_LOCKER_ARC=0x95bb2a42d3B685754548ffC8BC547E0fb2113252
LAUNCH_DEPLOY_BLOCK_ARC=21983226

# Indexer: run the in-process poll loop (1) and how many confirmations to wait for
LAUNCH_SYNC_LOOP=1
LAUNCH_SYNC_CONFIRMATIONS=2
# (Arc finalizes every block and keeps 0 confirmations regardless of the value above; LAUNCH_SYNC_CONFIRMATIONS_ARC overrides that)

# Token logo uploads: "local" stores files in .uploads/ (dev). In production set the Tigris/S3 secrets
# (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_ENDPOINT_URL_S3, AWS_REGION, BUCKET_NAME) instead.
IMAGE_STORE=local

# Wallets allowed to moderate posts (comma-separated, lowercase)
ADMIN_WALLETS=
